# StealthTag configuration
#
# SERVER-ONLY (never prefixed NEXT_PUBLIC_ — these must not reach the browser).
# The relay at /api/relay is the only thing that reads them.

# Pimlico bundler + paymaster API key. Without it, sweeping stays in demo mode
# rather than falling back to a direct browser -> Pimlico call.
PIMLICO_API_KEY=

# Chain segment of the Pimlico URL.
PIMLICO_CHAIN=sepolia

# Upstream JSON-RPC node the relay forwards reads to.
RELAY_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# PUBLIC (shipped to the browser). Nothing secret belongs here.

# Only used for wallet connection and as a scripts fallback.
NEXT_PUBLIC_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Force simulated sweeps regardless of relay configuration.
NEXT_PUBLIC_DEMO_MODE=false

# Absolute origin, needed only for server-side/relay calls outside the browser.
NEXT_PUBLIC_APP_URL=http://localhost:3000
